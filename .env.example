# Copia este archivo como .env y completa tus datos. El .env NO se sube a git.
# En el servidor estos valores los pone docker compose (ver despliegue/compose.yaml).

# ---- MySQL (la misma base la usa numi-docente-backend) ----
# Usa 127.0.0.1 y no "localhost": en Windows "localhost" prueba primero IPv6 y cada consulta tarda segundos.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=numi

# Clave para firmar la cookie de sesión. Genérala con:  python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=

# 1 = la cookie de sesión solo viaja por HTTPS (en el servidor)
SESSION_COOKIE_SECURE=0

# Backend de la app Numi (FastAPI): Monitoreo técnico revisa /salud y /api/paquetes
APP_API_URL=https://app-educativa-medellin-production-854b.up.railway.app

# Carpeta de los archivos que se suben desde Recursos (vacío = ./uploads)
UPLOADS_DIR=
